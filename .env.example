# ==============================================================================
# Compliance Sentinel Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YugabyteDB YSQL Database Configuration
# ------------------------------------------------------------------------------
YUGABYTEDB_HOST=yugabytedb
YUGABYTEDB_PORT=5433
DATABASE_NAME=compliance_sentinel
DATABASE_USER=yugabyte
DATABASE_PASSWORD=
# SQLAlchemy database URL format (psycopg 3 driver):
DATABASE_URL=postgresql+psycopg://yugabyte@yugabytedb:5433/compliance_sentinel

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 2. FastAPI Application & Authentication Settings
# ------------------------------------------------------------------------------
FASTAPI_ENV=development
SECRET_KEY=generate-a-secure-random-32-character-secret-key-for-production
JWT_SECRET_KEY=generate-a-secure-random-32-byte-secret-key-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_NAME=compliance_sentinel_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
DEBUG=true

# ------------------------------------------------------------------------------
# 3. LLM & Cognitive Services (Google Gemini API & MEKO Memory)
# ------------------------------------------------------------------------------
# Google Gemini API key for autonomous compliance auditors (Legal, Adversarial, etc.)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. n8n Workflow Orchestration Service
# ------------------------------------------------------------------------------
N8N_ENCRYPTION_KEY=replace-with-a-random-hex-encryption-key-for-n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://n8n:5678/
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_password

# ------------------------------------------------------------------------------
# 5. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Public browser-accessible URL for the FastAPI backend:
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. File & Object Storage Configuration
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/data/storage

